    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "jest": "^30.5.1"
  },
  "files": [
    "index.js",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
